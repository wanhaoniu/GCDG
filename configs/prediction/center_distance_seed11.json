{
  "backend": "geometry_heuristic",
  "dataset": {
    "root": "data/benchmark"
  },
  "output": {
    "dir": "outputs/center_distance_seed11"
  },
  "split": {
    "seed": 7,
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "overwrite": false,
    "reuse_existing_if_mismatch": false,
    "split_file": "benchmark/splits.json"
  },
  "features": {
    "det_conf_default": 1.0,
    "hidden_thresh": 0.01,
    "visible_thresh": 0.3,
    "object_knn_k": 4,
    "grasp_knn_k": 6,
    "object_edge_max_distance": null,
    "grasp_edge_max_distance": null,
    "lift_distance": 0.1,
    "cache_samples": true,
    "cache_depth_images": true,
    "allow_privileged_scene_geometry": false
  },
  "geometry_heuristic": {
    "mode": "center_distance",
    "distance_scale": 0.1,
    "bias": 3.0,
    "seed": 11
  },
  "training": {
    "seed": 11,
    "batch_size": 32
  },
  "evaluation": {
    "threshold": 0.5
  }
}
