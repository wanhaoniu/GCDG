{
  "backend": "object_only",
  "dataset": {
    "root": "data/benchmark"
  },
  "output": {
    "dir": "outputs/object_only_seed11"
  },
  "split": {
    "seed": 7,
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "overwrite": false,
    "reuse_existing_if_mismatch": false,
    "split_file": "benchmark/splits.json"
  },
  "features": {
    "det_conf_default": 1.0,
    "hidden_thresh": 0.01,
    "visible_thresh": 0.3,
    "object_knn_k": 4,
    "grasp_knn_k": 6,
    "object_edge_max_distance": null,
    "grasp_edge_max_distance": null,
    "lift_distance": 0.1,
    "cache_samples": true,
    "cache_depth_images": true,
    "allow_privileged_scene_geometry": false
  },
  "model": {
    "hidden_dim": 128,
    "object_only_hidden_dim": 128,
    "object_only_layers": 3,
    "decoder_layers": 3,
    "dropout": 0.1
  },
  "loss": {
    "label_weights": {
      "dep_progress_any": 1.0,
      "dep_sufficient": 0.5,
      "dep_approach": 1.0,
      "dep_lift": 1.0
    },
    "use_pos_weight": true,
    "pos_weight_max": 20.0,
    "focal_gamma": 0.0,
    "consistency_weight": 0.05
  },
  "training": {
    "seed": 11,
    "epochs": 45,
    "batch_size": 32,
    "lr": 0.001,
    "numpy_lr": 0.01,
    "weight_decay": 0.0001,
    "grad_clip": 5.0,
    "device": "cuda",
    "selection_metric": "edge.labels.dep_progress_any.ap",
    "checkpoint_selection": "validation"
  },
  "evaluation": {
    "threshold": 0.5
  }
}
